CSS CONTAINER:
    div.container{
        display: grid;
        grid-template-rows: repeat(4, 100px);
        grid-template-columns: repear(4, 1fr);
    }    

CSS ITEMS: 
  
    item.caixa1{
        grid-row-start: 1;
        grid-row-end: 3;
        grid-column-start: 1;
        grid-column-end: 5;
    }
    item.caixa2{
        grid-row-start: 3;
        grid-row-end: 5;
        grid-column-start: 1;
        grid-column-end: 3;
    }
    item.caixa3{
        grid-row-start: 3;
        grid-row-end: 5;
        grid-column-start: 3;
        grid-column-end: 5;
    }